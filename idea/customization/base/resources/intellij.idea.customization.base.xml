<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.ide.impl"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceInterface="com.intellij.openapi.updateSettings.UpdateStrategyCustomization"
                        serviceImplementation="com.intellij.openapi.updateSettings.base.ShowWhatIsNewPageAfterUpdateCustomization"
                        overrides="true"/>

    <errorHandler implementation="com.intellij.idea.customization.base.ReStudioErrorReportSubmitter" order="first"/>
    <!-- ReStudio: the origin and the trademark notice in Help > About. -->
    <aboutPopupDescriptionProvider implementation="com.intellij.idea.customization.base.ReStudioAboutDescription"/>

    <applicationService serviceInterface="com.intellij.platform.ide.customization.ExternalProductResourceUrls"
                        serviceImplementation="com.intellij.idea.customization.base.ReStudioExternalResourceUrls"
                        overrides="true"/>

    <applicationService serviceInterface="com.intellij.openapi.ui.DialogBackgroundImageProvider"
                        serviceImplementation="com.intellij.openapi.wm.impl.IdeaDialogBackgroundImageProvider"
                        overrides="true"/>
  </extensions>
</idea-plugin>
